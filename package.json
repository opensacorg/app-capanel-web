{
  "name": "app-capanel-web",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter frontend build",
    "dev": "pnpm --filter frontend dev",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm --filter frontend test",
    "test:ui": "pnpm --filter frontend test:ui",
    "compile": "pnpm --filter frontend compile",
    "format": "pnpm --filter frontend format",
    "email:dev": "bun run --filter emails dev",
    "email:export": "bun run --filter emails export"
  }
}
