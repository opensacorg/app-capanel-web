# Ignore ALL dependency folders anywhere they appear
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]

# Ignore cache and IDE configs
**/.idea/
**/.vscode/
**/.ruff_cache/
**/.mypy_cache/
**/.pytest_cache/
**/.tanstack/

# Ignore build and test outputs
**/dist/
**/blob-report/
**/test-results/
**/htmlcov/
**/.coverage
**/.coverage.*
**/screenshots/
**/.cache/

# Ignore Git
.git/
.github/

# Local-only development files
.claude/
.vscode/
.idea/
compose*.yml
tmp_*.txt
