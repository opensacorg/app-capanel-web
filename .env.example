# Copy to .env at the repository root and fill in. Both stacks read this one
# file: pydantic-settings loads it relative to the working directory, which is
# why every command is run from the root, and Docker Compose reads it for
# ${...} interpolation and passes it to the backend container.
#
# .env is gitignored. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Required by the application -------------------------------------------

PROJECT_NAME="California Accountability Panel"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.org
FIRST_SUPERUSER_PASSWORD=changethis

# Local development against a PostgreSQL on the host.
DATABASE_URL=postgresql://capanel:changethis@localhost:5432/capanel_dev

# Where CAASPP and ELPAC research files are read from: a local path or an
# s3:// URI. The importer streams from either.
RESEARCH_FILE_SOURCE_URI=/path/to/resources

# --- Optional ---------------------------------------------------------------

# The only accepted value is "development". It relaxes the "changethis" secret
# check and enables the dev-only /private routes, so leave it unset in any
# deployment.
FASTAPI_ENV=development

FRONTEND_HOST=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated. Not needed
# for the EC2 deployment, where Caddy serves both from one origin.
BACKEND_CORS_ORIGINS=

# Defaults to the state's own web server, so no local copy is needed.
# DASHBOARD_FILE_SOURCE_URI=https://www3.cde.ca.gov/researchfiles/cadashboard/

# SENTRY_DSN=

# Email. Unset SMTP_HOST disables sending entirely.
# SMTP_HOST=email-smtp.us-west-2.amazonaws.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=noreply@example.org

# --- Read by Docker Compose, not by the application -------------------------

# The public hostname Caddy obtains a certificate for. Use :80 for plain HTTP.
SITE_ADDRESS=capanel.example.org
POSTGRES_DB=capanel
POSTGRES_USER=capanel
POSTGRES_PASSWORD=changethis
AWS_REGION=us-west-2

# Where Caddy reads the compiled front end from. The deployment rsyncs into
# ./dist; locally, point it at the build output instead.
# FRONTEND_DIST=./frontend/dist
